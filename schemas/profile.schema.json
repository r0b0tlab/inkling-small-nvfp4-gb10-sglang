{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inkling/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "model_path", "server_executable", "base_args", "defaults", "mtp", "mem_fraction_static", "runtime_mode"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"enum": ["inkling-small-nvfp4", "inkling-small-mtp", "inkling-small-mxfp8-candidate"]},
    "description": {"type": "string", "minLength": 1},
    "model_path": {"const": "/models/Inkling-Small-NVFP4"},
    "server_executable": {"const": ["sglang", "serve"]},
    "base_args": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "--model-path"},
      "not": {"contains": {"const": "--model"}}
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_length", "concurrency", "kv_dtype", "chunk_size", "graph_max_decode_batch"],
      "properties": {
        "context_length": {"const": 32768},
        "concurrency": {"const": 1},
        "kv_dtype": {"enum": ["bf16", "mxfp8"]},
        "chunk_size": {"const": 2048},
        "graph_max_decode_batch": {"const": 1}
      }
    },
    "mtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "draft_layers", "total_layers"],
      "properties": {
        "layers": {"type": "integer", "minimum": 0},
        "draft_layers": {"type": "integer", "minimum": 0},
        "total_layers": {"type": "integer", "minimum": 0}
      }
    },
    "mem_fraction_static": {"const": 0.85},
    "runtime_mode": {"const": "native-cuda13-arm64-sm121"}
  },
  "allOf": [
    {
      "if": {"properties": {"name": {"const": "inkling-small-mxfp8-candidate"}}, "required": ["name"]},
      "then": {"properties": {"defaults": {"properties": {"kv_dtype": {"const": "mxfp8"}}}}},
      "else": {"properties": {"defaults": {"properties": {"kv_dtype": {"const": "bf16"}}}}}
    },
    {
      "if": {"properties": {"name": {"const": "inkling-small-mtp"}}, "required": ["name"]},
      "then": {"properties": {"mtp": {"const": {"layers": 8, "draft_layers": 1, "total_layers": 9}}}},
      "else": {"properties": {"mtp": {"const": {"layers": 0, "draft_layers": 0, "total_layers": 0}}}}
    }
  ]
}
