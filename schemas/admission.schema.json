{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inkling/admission.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "status", "descriptor_rooted", "non_symlink", "read_only"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PHASE0_PASS"},
    "descriptor_rooted": {"const": true},
    "non_symlink": {"const": true},
    "read_only": {"const": true},
    "read_only_mount": {"const": "ro"},
    "model_root": {"type": "string", "pattern": "^/[^.].*"},
    "runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {"const": "runtime-manifest-sha256"}
  }
}
