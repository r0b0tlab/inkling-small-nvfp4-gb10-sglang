{
  "schema_version": 1,
  "name": "inkling-small-mxfp8-candidate",
  "description": "Separately scored MXFP8 KV candidate; never substitutes for the BF16 correctness baseline.",
  "model_path": "/models/Inkling-Small-NVFP4",
  "server_executable": ["sglang", "serve"],
  "base_args": [
    "--trust-remote-code",
    "--model-type", "llm",
    "--model-path", "/models/Inkling-Small-NVFP4",
    "--served-model-name", "inkling-small-nvfp4",
    "--model-impl", "sglang",
    "--tp", "2",
    "--nnodes", "2",
    "--quantization", "modelopt_fp4",
    "--kv-cache-dtype", "mxfp8",
    "--attention-backend", "triton",
    "--page-size", "128",
    "--fp4-gemm-backend", "flashinfer_trtllm",
    "--moe-runner-backend", "flashinfer_cutlass",
    "--disable-flashinfer-autotune",
    "--mamba-radix-cache-strategy", "extra_buffer",
    "--swa-full-tokens-ratio", "0.1",
    "--mamba-full-memory-ratio", "0.1",
    "--enable-multimodal",
    "--reasoning-parser", "inkling",
    "--tool-call-parser", "inkling",
    "--random-seed", "0",
    "--cuda-graph-backend-decode", "disabled",
    "--cuda-graph-backend-prefill", "disabled"
  ],
  "defaults": {
    "context_length": 32768,
    "concurrency": 1,
    "kv_dtype": "mxfp8",
    "chunk_size": 1024,
    "graph_max_decode_batch": 1
  },
  "mtp": {
    "layers": 0,
    "draft_layers": 0,
    "total_layers": 0
  },
  "mem_fraction_static": 0.85,
  "runtime_mode": "native-cuda13-arm64-sm121"
}
